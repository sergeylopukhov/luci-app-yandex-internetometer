#!/bin/sh
# Portable engine used by the published APK/IPK packages.
# download: parallel HTTP GET loops, bytes counted from curl at completion or deadline.
# upload:   one long streamed POST per stream (body from dd, no payload file);
#           bytes are counted from the server-side SSE counter on statsUrl, so only
#           data acknowledged by the server enters the result.
# urls file: download lines are URLs; upload lines are "postUrl<TAB>statsUrl".
set -eu
[ "$#" -eq 6 ] || exit 2
kind="$1"; duration="$2"; streams="$3"; size="$4"; urls="$5"; sample="$6"
case "$kind" in download|upload) ;; *) exit 2;; esac
uint_range() {
  case "$1" in ''|*[!0-9]*) return 1;; esac
  [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}
uint_range "$duration" 1 60 && uint_range "$streams" 1 12 && uint_range "$size" 1024 200000000 || exit 2
[ -s "$urls" ] || exit 2
count="$(wc -l < "$urls")"; [ "$count" -gt 0 ] || exit 2
clock() { awk '{print $1}' /proc/uptime 2>/dev/null || date +%s; }
dir="${sample}.parts"; mkdir -p "$dir"; pids=""
cleanup() { kill $pids 2>/dev/null || true; wait $pids 2>/dev/null || true; rm -rf "$dir"; }
trap cleanup EXIT
trap 'exit 130' INT TERM
start="$(clock)"; end="$(awk -v s="$start" -v d="$duration" 'BEGIN{printf "%.3f",s+1+d}')"

# One long POST per stream: the body is generated by dd and streamed through a pipe,
# so memory stays at pipe buffers and no payload file is written.
upload_worker() {
  idx="$1"; post="$2"; stats="$3"
  sse="$dir/$idx.sse"; posts="$dir/$idx.posts"; : > "$sse"; : > "$posts"
  stats_pid=""; writer_pid=""
  # Several upload streams may use one probe. Read its counter only once:
  # broadcast SSE counters would otherwise multiply the same received bytes.
  if [ "$idx" -le "$count" ]; then
    curl -fsN --connect-timeout 4 --max-time $((duration + 3)) -H 'Accept: text/event-stream' "$stats" >> "$sse" 2>>"$dir/$idx.log" &
    stats_pid=$!
  fi
  trap 'kill "$writer_pid" "$stats_pid" 2>/dev/null || true; exit 130' INT TERM
  while :; do
    remaining="$(awk -v e="$end" -v n="$(clock)" 'BEGIN{printf "%.3f",e-n}')"
    awk -v r="$remaining" 'BEGIN{exit !(r>0)}' || break
    result=0
    dd if=/dev/zero bs=65536 2>/dev/null | curl -fsS --connect-timeout 4 --max-time "$remaining" -X POST -H 'Content-Type: application/octet-stream' -H 'Expect:' -T - -o /dev/null "$post" 2>>"$dir/$idx.log" & writer_pid=$!
    wait "$writer_pid" || result=$?; writer_pid=""
    # curl's --max-time and this clock race by fractions of a second: a timeout near the deadline is the normal end.
    if [ "$result" -eq 28 ] && awk -v e="$end" -v n="$(clock)" 'BEGIN{exit !(n>=e-0.5)}'; then
      echo ok >> "$posts"; break
    elif [ "$result" -eq 0 ]; then
      echo ok >> "$posts"
    else
      echo err >> "$posts"; break
    fi
  done
  [ -z "$stats_pid" ] || { kill "$stats_pid" 2>/dev/null || true; wait "$stats_pid" 2>/dev/null || true; }
}

download_worker() {
  idx="$1"; url="$2"; out="$dir/$idx.metrics"; : > "$out"
  curl_pid=""
  trap '[ -z "$curl_pid" ] || { kill "$curl_pid" 2>/dev/null || true; wait "$curl_pid" 2>/dev/null || true; }; exit 130' INT TERM
  while :; do
    request_at="$(clock)"
    remaining="$(awk -v e="$end" -v n="$(clock)" 'BEGIN{printf "%.3f",e-n}')"
    # curl fails at once with --max-time below 1 s on this build, so the tail under 1 s is not requested.
    awk -v r="$remaining" 'BEGIN{exit !(r>=1)}' || break
    result=0
    curl -fsS --connect-timeout 4 --max-time "$remaining" -o /dev/null -w '%{size_download} %{http_code}\n' "$url" > "$out.request" 2>>"$dir/$idx.log" &
    curl_pid=$!; wait "$curl_pid" || result=$?; curl_pid=""
    deadline=0
    if [ "$result" -eq 28 ] && awk -v e="$end" -v n="$(clock)" 'BEGIN{exit !(n>=e-0.5)}'; then deadline=1; fi
    done_at="$(clock)"
    awk -v rc="$result" -v deadline="$deadline" -v t="$done_at" -v started="$request_at" '
      BEGIN{bytes=0;responses=0;errors=(rc!=0&&!deadline)}
      NF==2 && $1 ~ /^[0-9]+$/ && $2 ~ /^2[0-9][0-9]$/ {
        if(rc==0 || deadline){bytes=$1;responses=1}
      }
      END{if(rc==0&&!responses)errors=1;printf "%.0f %d %d %.3f %.3f\n",bytes,responses,errors,t,started}
    ' "$out.request" >> "$out"
    [ "$result" -eq 0 ] && [ "$(awk 'END{print $3}' "$out")" -eq 0 ] || break
  done
}

i=1
while [ "$i" -le "$streams" ]; do
  n=$(( (i - 1) % count + 1 ))
  line="$(sed -n "${n}p" "$urls")"
  if [ "$kind" = upload ]; then
    post="$(printf '%s\n' "$line" | awk -F '\t' '{print $1}')"; stats="$(printf '%s\n' "$line" | awk -F '\t' '{print $2}')"
    case "$post" in http://*|https://*) ;; *) exit 2;; esac
    case "$stats" in http://*|https://*) ;; *) exit 2;; esac
    upload_worker "$i" "$post" "$stats" & pids="$pids $!"
  else
    case "$line" in http://*|https://*) ;; *) exit 2;; esac
    download_worker "$i" "$line" & pids="$pids $!"
  fi
  i=$((i + 1))
done

# Bytes: server-acknowledged for upload (SSE "u" events, field b), client-counted for download.
total_bytes() {
  if [ "$kind" = upload ]; then
    awk '/"k":"u"/ && /}/ { if (match($0, /"b":[0-9]+/)) s += substr($0, RSTART + 4, RLENGTH - 4) } END { printf "%.0f", s + 0 }' "$dir"/*.sse 2>/dev/null || printf 0
  else
    # curl reports bytes at request completion. For requests crossing warm-up,
    # estimate the measured share by their overlap with the measurement window.
    awk -v warm="$(awk -v s="$start" 'BEGIN{printf "%.3f",s+1}')" -v end="$end" '
      {lo=($5>warm?$5:warm); hi=($4<end?$4:end); span=$4-$5;
       if(hi>lo && span>0)b += $1*(hi-lo)/span;
       else if(span==0 && $4>warm && $4<=end)b += $1}
      END { printf "%.0f", b + 0 }
    ' "$dir"/*.metrics 2>/dev/null || printf 0
  fi
}
counts() {
  if [ "$kind" = upload ]; then
    awk '$1=="ok"{r++} $1=="err"{e++} END{printf "%d %d", r+0, e+0}' "$dir"/*.posts 2>/dev/null || printf '0 0'
  else
    awk '{r += $2; e += $3} END{printf "%d %d", r+0, e+0}' "$dir"/*.metrics 2>/dev/null || printf '0 0'
  fi
}
# Warm-up: the first second is excluded from the average (TCP ramp-up), as in the native engine.
baseline_t=""; baseline_b=0; prev_t=""; prev_b=0; average=0; current=0; bytes=0; responses=0; errors=0
final=false; rate=0.00
snapshot() {
  now="$(clock)"
  bytes_now="$(total_bytes)"
  set -- $(counts); responses="$1"; errors="$2"
  if [ -z "$baseline_t" ] && awk -v n="$now" -v s="$start" 'BEGIN{exit !(n-s>=1)}'; then
    baseline_t="$now"; baseline_b="$bytes_now"; prev_t="$now"; prev_b="$bytes_now"
    if [ "$kind" = download ]; then
      baseline_t="$(awk -v s="$start" 'BEGIN{printf "%.3f",s+1}')"; baseline_b=0
    fi
  fi
  elapsed="$(awk -v n="$now" -v s="$start" 'BEGIN{printf "%.3f",n-s}')"
  if [ -n "$baseline_t" ]; then
    # Download bytes are counted when a request completes, so the average ends at the last completion.
    t_end="$(awk -v n="$now" -v e="$end" 'BEGIN{printf "%.3f", (n<e?n:e)}')"
    if [ "$kind" = download ]; then
      last_done="$(awk '{if($4>m)m=$4} END{printf "%.3f", m+0}' "$dir"/*.metrics 2>/dev/null || printf 0)"
      if awk -v d="$last_done" -v b="$baseline_t" 'BEGIN{exit !(d>b)}'; then t_end="$(awk -v d="$last_done" -v e="$end" 'BEGIN{printf "%.3f", (d<e?d:e)}')"; else t_end="$baseline_t"; fi
    fi
    average="$(awk -v b="$((bytes_now - baseline_b))" -v s="$(awk -v a="$t_end" -v b="$baseline_t" 'BEGIN{printf "%.3f",a-b}')" 'BEGIN{if(s>0)printf "%.2f",b*8/s/1000000;else printf "0.00"}')"
    current="$(awk -v b="$((bytes_now - prev_b))" -v s="$(awk -v a="$now" -v b="$prev_t" 'BEGIN{printf "%.3f",a-b}')" 'BEGIN{if(s>0)printf "%.2f",b*8/s/1000000;else printf "0.00"}')"
    prev_t="$now"; prev_b="$bytes_now"
    bytes=$((bytes_now - baseline_b))
  fi
  printf '{"current_mbps":%s,"average_mbps":%s,"elapsed":%s,"responses":%s,"errors":%s,"final":%s}\n' "$current" "$average" "$elapsed" "$responses" "$errors" "$final" > "$sample.tmp"
  mv "$sample.tmp" "$sample"
}
# Publish atomically so the controller never reads a half-written JSON record.
while awk -v e="$end" -v n="$(clock)" 'BEGIN{exit !(n<e)}'; do
  snapshot
  [ "$errors" -eq 0 ] || break
  sleep 1
done
wait $pids 2>/dev/null || true
final=true; snapshot
rate="$average"
if [ "$errors" -gt 0 ] || [ "$responses" -eq 0 ] || [ "$bytes" -le 0 ] || ! awk -v r="$rate" 'BEGIN{exit !(r>0)}'; then
  printf '%s\n' 'Transfer failed: no valid throughput result' >&2
  exit 1
fi
printf '%s\n' "$rate"
